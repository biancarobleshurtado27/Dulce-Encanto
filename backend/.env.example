# Notificaciones: completar únicamente en .env; no subir credenciales.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_RECIPIENT=
ALERT_EMAIL_ENABLED=false
ALERT_DAILY_HOUR=08
