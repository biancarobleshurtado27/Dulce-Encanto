PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dulce_encanto
DB_USER=
DB_PASSWORD=

FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Genera una clave aleatoria privada de al menos 32 bytes.
JWT_SECRET=

# Asistente opcional (solo backend)
DEEPSEEK_API_KEY=
